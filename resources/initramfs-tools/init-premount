# Start the synoik splash in plymouthd's place (docs/fork/boot-splash.md §7.6). Installed as
# /etc/initramfs-tools/scripts/init-premount/plymouth, it overrides the plymouth package's script
# of that name, which starts plymouthd; the package's panic and init-bottom scripts talk to the
# splash as they would to plymouthd. The real root's synoik-system.service takes it over.

PREREQ="udev"

prereqs() {
    echo "${PREREQ}"
}

case "${1}" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

splash=/usr/local/libexec/synoik-splash
[ -x "${splash}" ] || exit 0

# plymouth's switches, which the splash honours as plymouthd does.
for argument in $(cat /proc/cmdline); do
    case "${argument}" in
        nosplash* | plymouth.enable=0 | rd.plymouth=0)
            exit 0
            ;;
    esac
done

# The keyboards' event nodes, where evdev is a module: udev loads it only once an input device
# shows up, and the splash reads them from the start.
modprobe -q evdev
mkdir -p /run/plymouth
# Its log goes to the kernel's, which the real root's journal takes in.
"${splash}" </dev/null >/dev/kmsg 2>&1 &

# Ready once it answers plymouth's clients, which it marks by writing the pid file: plymouthd's
# readiness is its daemonizing. Bounded: a splash that cannot bind still lets the boot go on.
i=0
while [ ! -e /run/plymouth/pid ] && [ "${i}" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done
