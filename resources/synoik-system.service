[Unit]
Description=synoik system compositor
Documentation=https://github.com/kov/synoik/blob/main/docs/fork/system-compositor.md
# It shows the shutdown splash, so it is up until the power goes (docs/fork/boot-splash.md §2.3):
# no conflict with shutdown.target, not stopped by the isolate of `systemctl poweroff`, spared by
# systemd-shutdown's final kill, and no `Requires=` on a mount that is unmounted on the way down.
DefaultDependencies=no
IgnoreOnIsolate=yes
SurviveFinalKillSignal=yes
# In place of the default dependencies, the units it needs, by name: basic.target can still be
# active from the initramfs at switch_root, which let an update boot start it before any of these.
# The tmpfiles hand it /run/plymouth and its cache, the bus carries logind's PrepareForShutdown.
After=systemd-journald.socket systemd-tmpfiles-setup.service systemd-sysusers.service
After=systemd-udev-trigger.service dbus.socket systemd-logind.service
# Offline updates show their progress on its splash: answering before the update starts.
Before=system-update-pre.target
# Sessions nest inside it, and a session's first connection is synchronous: be up before any
# login can start one.
Before=systemd-user-sessions.service
# Both want the display; only one can hold DRM master.
Conflicts=gdm.service
# Plymouth holds the card until it lets go of it, and the outer takes its place, splash and socket
# both (docs/fork/boot-splash.md §2.1). Nothing quits plymouth on the outer's failure: a restart
# follows, and plymouth's name is then the outer's, its listener waiting in the fd store, so a
# `plymouth quit` would end the restarted outer's splash.
After=plymouth-start.service
Conflicts=plymouth-quit.service
After=plymouth-quit.service
# Never give up restarting: a unit that hits the start limit fails, and a failed unit's fd store is
# where master would be lost.
StartLimitIntervalSec=0

[Service]
Type=notify
# The control processes too: the splash handover below writes the fd store.
NotifyAccess=exec
# The initramfs splash runs on until the outer is ready to draw: put its card and a channel to it
# in the fd store, over which the outer stops it once it is (boot-splash.md §7.2). Nothing to take
# when no splash waits. As root (`+`). Not `-`: with a splash up, an outer without its card would
# not be master, a dark boot; failing here restarts the unit instead.
ExecStartPre=+/usr/local/libexec/synoik-splash --hand-over
# GDM's order: plymouthd drops master but keeps its frame on screen, the outer modesets its own
# copy of that frame, and only then does plymouthd go — no dark gap between the two. As root (`+`).
# Only while the pid file is plymouthd's: plymouth's name is otherwise the outer's own, its
# listener waiting in the fd store with nobody to answer until the outer is up (boot-splash.md
# §7.2), and a client would wait on it forever.
ExecStartPre=+-/bin/sh -c '{ read -r pid </run/plymouth/pid && read -r comm </proc/$$pid/comm; } 2>/dev/null && [ "$$comm" = plymouthd ] && exec /usr/bin/plymouth deactivate'
ExecStart=synoik system-compositor
ExecStartPost=+-/bin/sh -c '{ read -r pid </run/plymouth/pid && read -r comm </proc/$$pid/comm; } 2>/dev/null && [ "$$comm" = plymouthd ] && exec /usr/bin/plymouth quit --retain-splash'
# Ready means answering plymouth's clients: the name frees a moment after that quit returns, and
# the outer writes the pid file once it holds it (plymouthd removed its own before letting go).
ExecStartPost=-/bin/sh -c 'for i in $$(seq 200); do [ -e /run/plymouth/pid ] && exit; sleep 0.01; done'
# A password prompt up while plymouth's name changed hands died with its connection, and systemd's
# agent does not ask again until the next request (boot-splash.md §7.2): a new agent asks every
# pending one, of the outer. Only an agent already running: the wall agent stops it for good once
# logins are allowed. As root (`+`).
ExecStartPost=+-/usr/bin/systemctl --no-block try-restart systemd-ask-password-plymouth.service
# Unprivileged: DRM master comes from opening the card first, input from the `input` group, the
# render node from `render` (Debian keeps it 0660; Fedora opens it to all), and nothing else needs
# root (docs/fork/system-compositor.md §1).
User=synoik-system
SupplementaryGroups=video input render
RuntimeDirectory=synoik-system
RuntimeDirectoryPreserve=restart
# Mesa's shader cache, for the transitions the outer draws (§5); the user has no home. From
# tmpfiles rather than `CacheDirectory=`, which would make it require the /var mount.
Environment=XDG_CACHE_HOME=/var/cache/synoik-system
# Out of system.slice, which shutdown stops.
Slice=-.slice
# Master lives on the open file, not the process. systemd holding a reference to it keeps the card
# mastered across a crash, so nobody else can claim it in the gap and the restarted outer is
# master again without asking (§1, §7).
FileDescriptorStoreMax=4
# Keep it even across a stop: releasing master is a decision (hand the display to another display
# manager), so it is an explicit `systemctl clean --what=fdstore synoik-system`, never a side
# effect of a crash loop.
FileDescriptorStorePreserve=yes
Restart=always
RestartSec=100ms

[Install]
WantedBy=graphical.target system-update.target
