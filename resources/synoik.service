# The compositor of a user's session under gnome-session, as gnome-shell's
# data/org.gnome.Shell@.service.in (50.3) runs `gnome-shell --mode=user`.
# Install in /usr/lib/systemd/user.
[Unit]
Description=synoik
OnFailure=gnome-session-shutdown.target
OnFailureJobMode=replace-irreversibly
# Unlike gnome-shell, synoik can quit on its own (the quit action): that ends the
# session too, rather than leaving a headless gnome-session for the next login to rejoin.
OnSuccess=gnome-session-shutdown.target
OnSuccessJobMode=replace-irreversibly
CollectMode=inactive-or-failed
RefuseManualStart=on
RefuseManualStop=on

After=gnome-session-manager.target

Requisite=gnome-session-initialized.target
PartOf=gnome-session-initialized.target
Before=gnome-session-initialized.target

[Service]
Slice=session.slice
Type=notify
# Our own GSettings schema lives in a private dir, not the shared
# glib-2.0/schemas — see the %install notes in synoik.spec.rpkg. This dir is
# searched ahead of the system one, and inherited by everything the session
# launches, so gnome-control-center sees those keys too.
Environment=GSETTINGS_SCHEMA_DIR=/usr/share/synoik/glib-2.0/schemas
# Room for synoik to lock its own memory out of swap (utils::memory::MemoryLocker);
# the default 8M is spent on its code alone.
LimitMEMLOCK=768M
ExecStart=synoik --session
# What synoik exported to the user manager, which outlives the session.
ExecStopPost=-systemctl --user unset-environment WAYLAND_DISPLAY DISPLAY SYNOIK_SOCKET
Restart=no
TimeoutStopSec=5
