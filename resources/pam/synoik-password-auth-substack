#%PAM-1.0
# The distro's password-auth, wrapped so that an empty or missing one denies instead of letting
# anyone in (docs/fork/greeter.md §3; GDM 51's gdm-service-auth-substack.pam.in).
auth     include   password-auth
auth     required  pam_deny.so

password include   password-auth
password required  pam_deny.so
