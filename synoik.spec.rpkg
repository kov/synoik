%bcond_without check

%global cargo_install_lib 0

# We want panic backtraces to work without installing the debuginfo package,
# so we leave the debuginfo in the main binary.
%global debug_package %{nil}
%global __strip /bin/true

# To reduce the file size, do some convincing of rust-srpm-macros
# to leave alone the chosen debug settings from Cargo.toml.
%global rustflags_debuginfo please-remove-me
%global build_rustflags %{shrink:
  -Copt-level=%rustflags_opt_level
  -Ccodegen-units=%rustflags_codegen_units
  -Cstrip=none
  %{expr:0%{?_include_frame_pointers} && ("%{_arch}" != "ppc64le" && "%{_arch}" != "s390x" && "%{_arch}" != "i386") ? "-Cforce-frame-pointers=yes" : ""}
  -Clink-arg=-Wl,-z,relro
  -Clink-arg=-Wl,-z,now
  %[0%{?_package_note_status} ? "-Clink-arg=%_package_note_flags" : ""]
  --cap-lints=warn
}

# Convince rust-srpm-macros to use Cargo.lock with the Smithay commit.
%global __cargo_common_opts %{?_smp_mflags} -Z avoid-dev-deps --locked

%global version {{{ git_dir_version }}}

Name:           synoik
Version:        %{version}
Release:        1%{?dist}
Summary:        GNOME-behaviors Wayland desktop, written in Rust

SourceLicense:  GPL-3.0-only

# (MIT OR Apache-2.0) AND BSD-3-Clause
# (MIT OR Apache-2.0) AND Unicode-3.0
# 0BSD OR MIT OR Apache-2.0
# Apache-2.0
# Apache-2.0 AND MIT
# Apache-2.0 OR MIT
# Apache-2.0 OR MIT OR Unlicense
# Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT
# BSD-2-Clause
# BSD-2-Clause OR Apache-2.0 OR MIT
# BSD-3-Clause OR MIT OR Apache-2.0
# GPL-3.0-only
# ISC
# MIT
# MIT OR Apache-2.0
# MIT OR Apache-2.0 OR LGPL-2.1-or-later
# MIT OR Apache-2.0 OR Zlib
# MIT OR Zlib OR Apache-2.0
# MPL-2.0
# Unlicense OR MIT
# Zlib
# Zlib OR Apache-2.0 OR MIT
License:        ((MIT OR Apache-2.0) AND BSD-3-Clause) AND ((MIT OR Apache-2.0) AND Unicode-3.0) AND (0BSD OR MIT OR Apache-2.0) AND Apache-2.0 AND (Apache-2.0 AND MIT) AND (Apache-2.0 OR MIT) AND (Apache-2.0 OR MIT OR Unlicense) AND (Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT) AND BSD-2-Clause AND (BSD-2-Clause OR Apache-2.0 OR MIT) AND (BSD-3-Clause OR MIT OR Apache-2.0) AND GPL-3.0-only AND ISC AND MIT AND (MIT OR Apache-2.0) AND (MIT OR Apache-2.0 OR LGPL-2.1-or-later) AND (MIT OR Apache-2.0 OR Zlib) AND (MIT OR Zlib OR Apache-2.0) AND MPL-2.0 AND (Unlicense OR MIT) AND Zlib AND (Zlib OR Apache-2.0 OR MIT)
# LICENSE.dependencies contains a full license breakdown

VCS:            {{{ git_dir_vcs }}}
Source:         {{{ git_dir_pack }}}

BuildRequires:  cargo-rpm-macros >= 26
BuildRequires:  pkgconfig(udev)
BuildRequires:  pkgconfig(gbm)
BuildRequires:  pkgconfig(xkbcommon)
BuildRequires:  wayland-devel
BuildRequires:  pkgconfig(libinput)
BuildRequires:  pkgconfig(dbus-1)
BuildRequires:  pkgconfig(systemd)
BuildRequires:  pkgconfig(libseat)
BuildRequires:  pkgconfig(libdisplay-info)
BuildRequires:  pipewire-devel
BuildRequires:  pango-devel
# glib-compile-schemas, for our own GSettings schema
BuildRequires:  glib2-devel
BuildRequires:  cairo-gobject-devel
# Needed for pipewire-rs
BuildRequires:  clang
# Needed for some tests with a surfaceless EGL renderer
BuildRequires:  mesa-libEGL
# glycin, which decodes the wallpaper
BuildRequires:  lcms2-devel
BuildRequires:  fontconfig-devel
BuildRequires:  libseccomp-devel

Requires:       mesa-dri-drivers
Requires:       mesa-libEGL

# The wallpaper is decoded in a sandboxed glycin loader process, the way mutter decodes it: the
# loaders are the format support, and bwrap is what confines them. Without either there is no
# wallpaper at all.
Requires:       glycin-loaders
Requires:       bubblewrap

# Loaded through dlopen
Requires:       libwayland-server

# Integrated Xwayland support. Not packaged on EPEL
%if 0%{?fedora}
Requires:       xwayland-satellite >= 0.7
%endif

# Portal implementations used by synoik
Recommends:     xdg-desktop-portal-gtk
Recommends:     xdg-desktop-portal-gnome
Recommends:     gnome-keyring

# Suggested utilities, bound in the default config
Recommends:     alacritty
Recommends:     fuzzel
Recommends:     swaylock
Recommends:     waybar
# Suggested utilities
Recommends:     swaybg
Recommends:     mako
Recommends:     swayidle

%description
A GNOME-behaviors Wayland desktop, written in Rust.

A faithful Rust rewrite of gnome-shell's behavior on an owned Vulkan render
stack, free of GObject, Cogl, Clutter and GJS.

%prep
{{{ git_dir_setup_macro }}}

%cargo_prep -N

# We're doing an online build.
sed -i 's/^offline = true$//' .cargo/config.toml

# Final step in leaving alone our debug settings.
sed -i 's/.*please-remove-me$//' .cargo/config.toml

# Set the commit string.
sed -i 's/\[env\]/[env]\nSYNOIK_BUILD_COMMIT="%{version}"/' .cargo/config.toml

%build
%cargo_build

target/rpm/synoik completions bash > ./synoik
target/rpm/synoik completions fish > ./synoik.fish
target/rpm/synoik completions zsh > ./_synoik

%install
%cargo_install

install -Dm755 -t %{buildroot}%{_bindir} ./resources/synoik-session
install -Dm644 -t %{buildroot}%{_datadir}/wayland-sessions ./resources/synoik.desktop
install -Dm644 -t %{buildroot}%{_datadir}/xdg-desktop-portal ./resources/synoik-portals.conf
install -Dm644 -t %{buildroot}%{_userunitdir} ./resources/synoik.service
install -Dm644 -t %{buildroot}%{_userunitdir} ./resources/synoik-shutdown.target

# Our GSettings schemas, in a private dir rather than %%{_datadir}/glib-2.0/schemas:
# our own keybindings, our copies of the mutter and gnome-shell schemas (so the
# session still has editable keybindings once those packages are replaced), and the
# override carrying the defaults we knowingly differ on. Two files declaring one schema
# id in a single directory means glib-compile-schemas drops one of them and still exits
# 0 — and this is meant to be installable beside a real gnome-shell, whose copies these
# would collide with. The session finds them through GSETTINGS_SCHEMA_DIR (see
# resources/synoik.service), which is searched ahead of the system dir; an override only
# tunes schemas in its own directory, which is why the copies ship with it. Compiled
# here so there is nothing to do in %%post.
install -Dm644 -t %{buildroot}%{_datadir}/synoik/glib-2.0/schemas \
    ./resources/schemas/*.gschema.xml ./resources/schemas/*.gschema.override
glib-compile-schemas --strict %{buildroot}%{_datadir}/synoik/glib-2.0/schemas

install -Dm644 -t %{buildroot}%{bash_completions_dir} ./synoik
install -Dm644 -t %{buildroot}%{fish_completions_dir} ./synoik.fish
install -Dm644 -t %{buildroot}%{zsh_completions_dir} ./_synoik

%if %{with check}
%check
%cargo_test -- --workspace
%endif

%files
%license LICENSE
%doc README.md
%doc docs/wiki
%{_bindir}/synoik
%{_bindir}/synoik-session
%{_datadir}/wayland-sessions/synoik.desktop
%dir %{_datadir}/xdg-desktop-portal
%{_datadir}/xdg-desktop-portal/synoik-portals.conf
%{_userunitdir}/synoik.service
%{_userunitdir}/synoik-shutdown.target
%dir %{_datadir}/synoik
%{_datadir}/synoik/glib-2.0/schemas/*.gschema.xml
%{_datadir}/synoik/glib-2.0/schemas/*.gschema.override
%{_datadir}/synoik/glib-2.0/schemas/gschemas.compiled
%{bash_completions_dir}/synoik
%{fish_completions_dir}/synoik.fish
%{zsh_completions_dir}/_synoik

%changelog
{{{ git_dir_changelog }}}

