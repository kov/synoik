#!/bin/sh
# Pre-commit checks for gnome-shell-rs. To enable in this clone:
#   git config core.hooksPath .githooks
#
# Formatting and clippy cover the WHOLE workspace (--all / --workspace): the
# root package is `niri`, so a bare `cargo fmt`/`cargo clippy` skips the other
# crates (niri-config, niri-ipc, niri-vk, …) and lets drift through. rustfmt
# drift has ridden into commits before (the volume-slider slice); this gate
# stops it. Clippy is strict: -D warnings across all targets.

cargo fmt --all -- --check || {
    echo "cargo fmt found issues; run 'cargo fmt --all' to fix" >&2
    exit 1
}

cargo clippy --workspace --all-targets -- -D warnings || {
    echo "cargo clippy found issues" >&2
    exit 1
}
